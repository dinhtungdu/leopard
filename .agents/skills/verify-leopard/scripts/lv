#!/bin/bash
# Drives a built Leopard bundle the way a user runs it. See ../SKILL.md.
#
#   lv up                    start a run on this machine as you: own home, ports, scratch
#   lv up --container [IMG]  start a run in a throwaway container instead (default alpine:3.20)
#   lv doctor                read-only: is this run worth driving?
#   lv x CMD...              run a shell command in the run (sh -c)
#   lv proof NAME CMD...     like x, and save cmd, stdout, stderr, exit code as proof
#   lv shot NAME URL         browser screenshot + ARIA snapshot of a URL as proof
#   lv down                  stop the run and remove its home and scratch; proof stays
#   lv ls                    runs on this machine, and whether they still run
#
# Commands see LEOPARD_HOME and LV_SCRATCH (a folder for fixtures), and find
# `leopard` on PATH. LV_RUN picks a run; default is the last `lv up`. LV_BIN
# picks the bundle; default is dist/leopard-php<lowest>-linux-<arch>.
set -euo pipefail
REPO=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
ROOT=$REPO/dist/verify
LABEL=leopard-verify
die() { echo "lv: $*" >&2; exit 1; }

load() {
  run=${LV_RUN:-$(cat "$ROOT/current" 2>/dev/null || true)}
  [ -n "$run" ] && [ -f "$ROOT/$run/env" ] || die "no run. Start one with: lv up"
  # shellcheck disable=SC1090
  . "$ROOT/$run/env"
}

# Runs a shell command inside the run. umask 022 like a usual login shell.
inrun() {
  if [ "$LV_MODE" = container ]; then
    docker exec -i -e LEOPARD_HOME=/var/lib/leopard -e LV_SCRATCH=/scratch "$LV_C" sh -c "umask 022; cd /scratch; $1"
  else
    env HOME="$LV_TMP/user" LEOPARD_HOME="$LV_TMP/home" LV_SCRATCH="$LV_TMP/scratch" \
      WP_CLI_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/leopard-verify/wp-cli" PATH="$LV_TMP/bin:$PATH" \
      LEOPARD_PACKS_URL="file://$REPO/dist/packs/" \
      sh -c "umask 022; cd \"\$LV_SCRATCH\"; $1"
  fi
}

free_port() { # first port >= $1 that nothing listens on
  p=$1
  while ss -Hltn "sport = :$p" | grep -q .; do p=$((p + 1)); done
  echo "$p"
}

up() {
  mode=host image=
  if [ "${1:-}" = --container ]; then mode=container image=${2:-alpine:3.20}; fi
  bin=${LV_BIN:-$(ls "$REPO"/dist/leopard-php*-linux-"$(uname -m)" 2>/dev/null | sort -V | head -1)}
  [ -n "$bin" ] && [ -x "$bin" ] || die "no bundle in dist/. Build first: ./build.sh"
  bin=$(realpath "$bin")
  run=$(date +%Y%m%d-%H%M%S)-$$
  dir=$ROOT/$run
  mkdir -p "$dir"
  port=$(free_port 18080)
  db_port=$(free_port 13306)
  c= tmp=
  if [ $mode = container ]; then
    # Host networking: the browser, curl, and `--host` sites on extra ports all
    # see the same URLs as the container.
    c=leopard-verify-$run
    packs=()
    [ -d "$REPO/dist/packs" ] && packs=(-v "$REPO/dist/packs:/packs:ro")
    docker run -d --name "$c" --label "$LABEL=$run" --network host \
      -v "$bin:/usr/local/bin/leopard:ro" "${packs[@]}" \
      -v leopard-verify-wpcache:/root/.wp-cli/cache \
      -e LEOPARD_PACKS_URL=file:///packs \
      "$image" sh -c 'mkdir -p /scratch && exec sleep infinity' >/dev/null
  else
    # A short path: Unix sockets under the home must stay under 107 bytes.
    tmp=/tmp/lv-$run
    mkdir -p "$tmp/home" "$tmp/user" "$tmp/scratch" "$tmp/bin"
    ln -s "$bin" "$tmp/bin/leopard"
  fi
  cat >"$dir/env" <<EOF
LV_RUN=$run
LV_MODE=$mode
LV_C=$c
LV_IMAGE=$image
LV_TMP=$tmp
LV_BIN=$bin
LV_BIN_SHA=$(sha256sum "$bin" | cut -c1-12)
LV_PORT=$port
LV_DB_PORT=$db_port
LV_URL=http://127.0.0.1:$port
LV_PROOF=$dir
EOF
  echo "$run" >"$ROOT/current"
  . "$dir/env"
  inrun "LEOPARD_PORT=$port LEOPARD_DB_PORT=$db_port LEOPARD_URL=$LV_URL leopard start --json" \
    >"$dir/start.json" 2>"$dir/start.stderr" ||
    { cat "$dir/start.json" "$dir/start.stderr" >&2; die "leopard start failed; run: lv down"; }
  cat "$dir/env"
}

doctor() {
  load
  ok=true
  check() { if eval "$2" >/dev/null 2>&1; then echo "ok    $1"; else echo "FAIL  $1"; ok=false; fi; }
  if [ "$LV_MODE" = container ]; then
    check "container $LV_C runs and is ours" \
      "[ \"\$(docker inspect -f '{{.State.Running}} {{index .Config.Labels \"$LABEL\"}}' $LV_C)\" = 'true $LV_RUN' ]"
  else
    check "home $LV_TMP/home exists and is this run's" "[ \"\$(readlink $LV_TMP/bin/leopard)\" = $LV_BIN ]"
  fi
  check "bundle unchanged since lv up ($LV_BIN_SHA)" "[ \"\$(sha256sum $LV_BIN | cut -c1-12)\" = $LV_BIN_SHA ]"
  check "bundle newer than leopard.sh, leopard.php, SKILL.md" \
    "[ -z \"\$(find $REPO/leopard.sh $REPO/leopard.php $REPO/skills/using-leopard/SKILL.md -newer $LV_BIN)\" ]"
  check "web answers at $LV_URL" "curl -fsS -o /dev/null $LV_URL/"
  check "leopard doctor --json is ok" "inrun 'leopard doctor --json' | grep -q '\"ok\": *true'"
  $ok
}

proof() {
  load
  name=$1; shift
  mkdir -p "$LV_PROOF/$name"
  f=$LV_PROOF/$name/$(date +%H%M%S%N | cut -c1-9)
  printf '%s\n' "$*" >"$f.cmd"
  set +e
  inrun "$*" >"$f.out" 2>"$f.err" </dev/null
  code=$?
  set -e
  echo "$code" >"$f.exit"
  cat "$f.out"
  [ -s "$f.err" ] && sed 's/^/stderr: /' "$f.err" >&2
  echo "exit $code -> $f.{cmd,out,err,exit}" >&2
  return "$code"
}

shot() {
  load
  name=$1 url=$2
  mkdir -p "$LV_PROOF/$name"
  export AGENT_BROWSER_SESSION=lv-$LV_RUN
  agent-browser open "$url" >/dev/null
  agent-browser set viewport 1280 800 2 >/dev/null
  agent-browser snapshot >"$LV_PROOF/$name/page.aria.txt"
  agent-browser screenshot "$LV_PROOF/$name/page.png" >/dev/null
  agent-browser get url
  echo "-> $LV_PROOF/$name/page.{png,aria.txt}" >&2
}

down() {
  load
  AGENT_BROWSER_SESSION="lv-$LV_RUN" agent-browser close >/dev/null 2>&1 || true
  if [ "$LV_MODE" = container ]; then
    docker rm -f "$LV_C" >/dev/null 2>&1 || true
    echo "removed $LV_C; proof kept in $LV_PROOF"
    return
  fi
  [ -d "$LV_TMP" ] || { echo "already down; proof kept in $LV_PROOF"; return; }
  inrun 'leopard stop' >/dev/null 2>&1 || true
  # The run's path is unique, so anything still naming it is ours.
  left=$(pgrep -f "$LV_TMP/" || true)
  [ -z "$left" ] || { echo "lv: killing leftovers: $left" >&2; kill $left 2>/dev/null || true; sleep 1; }
  rm -rf "$LV_TMP"
  echo "stopped and removed $LV_TMP; proof kept in $LV_PROOF"
}

ls_runs() {
  for d in "$ROOT"/*/env; do
    [ -f "$d" ] || continue
    (
      LV_MODE=container LV_TMP=
      . "$d"
      if [ "$LV_MODE" = container ]; then
        state=$(docker inspect -f '{{.State.Status}}' "$LV_C" 2>/dev/null) || state=gone
      elif [ -d "$LV_TMP" ]; then state=up; else state=gone; fi
      echo "$LV_RUN  $LV_MODE  $state  $LV_URL"
    )
  done
}

case ${1:-} in
  up) shift; up "$@" ;;
  doctor) doctor ;;
  x) shift; load; inrun "$*" ;;
  proof) shift; [ $# -ge 2 ] || die "usage: lv proof NAME CMD..."; proof "$@" ;;
  shot) shift; [ $# -eq 2 ] || die "usage: lv shot NAME URL"; shot "$@" ;;
  down) down ;;
  ls) ls_runs ;;
  *) sed -n '2,16p' "$0"; exit 2 ;;
esac
